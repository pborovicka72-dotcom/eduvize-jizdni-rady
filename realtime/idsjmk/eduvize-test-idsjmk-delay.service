[Unit]
Description=Eduvize TEST IDS JMK live delays
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/srv/eduvize-test/idsjmk-delay-20261121-r1/venv/bin/python /srv/eduvize-test/idsjmk-delay-20261121-r1/collect_delay.py
User=eduvize-admin
Group=eduvize-admin
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/eduvize-test-national-data/idsjmk
MemoryMax=384M
CPUQuota=50%
TimeoutStartSec=60
